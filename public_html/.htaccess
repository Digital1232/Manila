# Manila Institute of Paramedical Science: web server rules (Apache / LiteSpeed on Hostinger)

Options -Indexes -MultiViews
DirectoryIndex index.php
ServerSignature Off
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # SSL certificate validation must always reach the server
  RewriteRule ^\.well-known/ - [L]

  # One canonical address: HTTPS, without www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301,NE]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

  # Never serve hidden files, the application code or private notes
  RewriteRule (^|/)\. - [F,L]
  RewriteRule ^app(/|$) - [F,L]

  # Only index.php may run; any other .php request is answered by the site (404/410), never executed
  RewriteCond %{REQUEST_URI} !^/index\.php$
  RewriteRule \.(php\d?|phtml|phar)$ index.php [L]

  # Everything that is not a real file goes to the front controller
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L]
</IfModule>

# Block backups, logs and config files if any are ever uploaded here by mistake
<FilesMatch "\.(bak|old|orig|save|swp|sql|gz|tar|zip|log|ini|env|lock|yml|yaml|md|sh|dist)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  # "set" (not "always set") so these merge with the same headers sent by index.php instead of duplicating them
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header unset X-Powered-By
  # Versioned assets (?v=...) can be cached for a year
  <FilesMatch "\.(css|js|webp|jpg|jpeg|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.webmanifest$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>
